        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_llm_tokens_24h",
