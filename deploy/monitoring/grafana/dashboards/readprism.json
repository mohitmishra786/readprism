{
  "uid": "readprism-overview",
  "title": "ReadPrism overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "readprism"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "sum by (status) (rate(readprism_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(readprism_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue wait p95",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_queue_wait_seconds{quantile=\"95\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Items ingested per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_items_ingested_last_hour",
          "legendFormat": "items"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sources by feed health",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_sources",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Digest build duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_task_runtime_seconds{quantile=\"95\",task=~\".*build_digest.*\"}",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Digest on-time ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "readprism-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "readprism-prometheus"
          },
          "expr": "readprism_digest_on_time_ratio",
          "legendFormat": "on time"
        }
      ]
    },
    {
