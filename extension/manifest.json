{
  "manifest_version": 3,
  "name": "ReadPrism",
  "version": "0.3.0",
  "description": "Save & rate pages into ReadPrism, add the current site as a source or creator \u2014 one click.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to ReadPrism",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "readprism@readprism.app",
      "strict_min_version": "109.0"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
