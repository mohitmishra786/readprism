{
  "manifest_version": 3,
  "name": "ReadPrism",
  "version": "0.2.0",
  "description": "Save & rate pages into ReadPrism, add the current site as a source or creator — one click.",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "https://readprism.app/*", "http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to ReadPrism",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["detect-feed.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "readprism@readprism.app",
      "strict_min_version": "109.0"
    }
  }
}
